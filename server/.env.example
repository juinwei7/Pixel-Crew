# 目標 repo 的絕對路徑,Claude Code CLI 會在這個目錄下執行
TARGET_REPO_PATH=/absolute/path/to/your/repo

# acceptEdits | bypassPermissions | plan | dontAsk (參見 `claude --help` 的 --permission-mode)
PERMISSION_MODE=acceptEdits

# claude 執行檔名稱或絕對路徑,預設吃 PATH 裡的 claude
CLAUDE_BIN=claude
CODEX_BIN=codex
CODEX_SANDBOX=workspace-write

PORT=8787
HOST=127.0.0.1

# 本地 SQLite；未設定時使用 server/data/cockpit.sqlite
DB_PATH=

# 正規化 NPC PNG 與已驗證 GIF；未設定時使用 DB_PATH 同層的 avatars/ 目錄
AVATAR_DIR=
